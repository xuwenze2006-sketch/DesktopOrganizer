<Window x:Class="DesktopOrganizer.SimpleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入名称" Height="150" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="请输入名称：" Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox" Height="26" VerticalContentAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="70" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="确定" Width="70" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
