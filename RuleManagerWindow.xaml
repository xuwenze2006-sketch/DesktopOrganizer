<Window x:Class="DesktopOrganizer.RuleManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="可解释整理规则"
        Width="1040"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12"
                CornerRadius="8"
                Background="#FFF0F7FF"
                BorderBrush="#FF9CC8F2"
                BorderThickness="1">
            <TextBlock TextWrapping="Wrap"
                       Text="规则保存后始终回到草稿且默认禁用。必须先逐项预览、明确确认，再执行一次；只有试运行完成后才能启用自动应用。规则只改变虚拟分组、标签或待整理收件箱，不移动、重命名或删除真实文件。"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="规则列表" FontWeight="SemiBold" FontSize="15" Margin="2,0,0,8"/>
                <ListBox x:Name="RuleList"
                         Grid.Row="1"
                         SelectionChanged="RuleList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Padding="7,2"
                                            CornerRadius="8"
                                            Background="#FFE8EEF6">
                                        <TextBlock Text="{Binding LifecycleText}"
                                                   FontSize="11"
                                                   Foreground="#FF334155"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding ConditionsText}"
                                           Margin="0,4,0,0"
                                           Foreground="#FF475569"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ActionText}"
                                           Margin="0,3,0,0"
                                           Foreground="#FF64748B"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="新建规则" MinWidth="82" Margin="0,0,8,8" Click="NewRule_Click"/>
                    <Button Content="导入 JSON…" MinWidth="88" Margin="0,0,8,8" Click="Import_Click"/>
                    <Button Content="导出 JSON…" MinWidth="88" Margin="0,0,0,8" Click="Export_Click"/>
                </WrapPanel>
            </Grid>

            <Border Grid.Column="2"
                    Padding="16"
                    CornerRadius="8"
                    Background="#FFF8FAFC"
                    BorderBrush="#FFE2E8F0"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="规则编辑" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock x:Name="LifecycleText"
                                       Grid.Column="1"
                                       Foreground="#FF475569"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="规则名称" Margin="0,14,0,4" FontWeight="SemiBold"/>
                        <TextBox x:Name="RuleNameBox"
                                 Height="30"
                                 Padding="7,4"
                                 TextChanged="EditorChanged"/>

                        <TextBlock Text="条件（以下已填写条件同时满足时命中）"
                                   Margin="0,16,0,7"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="扩展名"
                                   Foreground="#FF475569"/>
                        <TextBox x:Name="ExtensionsBox"
                                 Height="30"
                                 Margin="0,4,0,0"
                                 Padding="7,4"
                                 ToolTip="用空格、逗号或分号分隔，例如：.docx, pdf, txt"
                                 TextChanged="EditorChanged"/>
                        <TextBlock Text="名称包含"
                                   Margin="0,10,0,0"
                                   Foreground="#FF475569"/>
                        <TextBox x:Name="NameContainsBox"
                                 Height="30"
                                 Margin="0,4,0,0"
                                 Padding="7,4"
                                 TextChanged="EditorChanged"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="项目类型" Foreground="#FF475569"/>
                                <ComboBox x:Name="ItemKindSelector"
                                          Height="30"
                                          Margin="0,4,0,0"
                                          DisplayMemberPath="Name"
                                          SelectionChanged="EditorChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="顶层项目标记" Foreground="#FF475569"/>
                                <CheckBox x:Name="ProjectMarkerCheckBox"
                                          Margin="0,9,0,0"
                                          Content="必须存在项目标记"
                                          Click="EditorChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="创建于最近多少天" Foreground="#FF475569"/>
                                <TextBox x:Name="CreatedDaysBox"
                                         Height="30"
                                         Margin="0,4,0,0"
                                         Padding="7,4"
                                         ToolTip="留空表示不限制；允许 1 到 3650"
                                         TextChanged="EditorChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="修改于最近多少天" Foreground="#FF475569"/>
                                <TextBox x:Name="ModifiedDaysBox"
                                         Height="30"
                                         Margin="0,4,0,0"
                                         Padding="7,4"
                                         ToolTip="留空表示不限制；允许 1 到 3650"
                                         TextChanged="EditorChanged"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,16,0,14"/>
                        <TextBlock Text="命中动作" FontWeight="SemiBold"/>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ActionSelector"
                                      Height="30"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="ActionSelector_SelectionChanged"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="ActionTargetLabel"
                                           Text="目标名称"
                                           Foreground="#FF475569"/>
                                <TextBox x:Name="ActionTargetBox"
                                         Height="30"
                                         Margin="0,4,0,0"
                                         Padding="7,4"
                                         TextChanged="EditorChanged"/>
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,16,0,0"
                                Padding="10"
                                Background="#FFFFF8E7"
                                BorderBrush="#FFF0C36A"
                                BorderThickness="1"
                                CornerRadius="6">
                            <TextBlock TextWrapping="Wrap"
                                       Text="“保存为草稿”会禁用该规则并清除此前预览/试运行资格；修改后必须重新完成完整生命周期。"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   MinHeight="22"
                   Margin="2,0,2,8"
                   Foreground="#FF475569"
                   TextWrapping="Wrap"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel>
                <Button x:Name="SaveDraftButton"
                        Content="保存为草稿"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Click="SaveDraft_Click"/>
                <Button x:Name="PreviewButton"
                        Content="逐项预览…"
                        MinWidth="92"
                        Margin="0,0,8,0"
                        Click="Preview_Click"/>
                <Button x:Name="ExecuteOnceButton"
                        Content="执行一次…"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="ExecuteOnce_Click"/>
                <Button x:Name="EnableButton"
                        Content="启用自动应用…"
                        MinWidth="105"
                        Margin="0,0,8,0"
                        Click="Enable_Click"/>
                <Button x:Name="DisableButton"
                        Content="停用自动应用"
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Click="Disable_Click"/>
                <Button x:Name="DeleteButton"
                        Content="删除规则…"
                        MinWidth="82"
                        Click="Delete_Click"/>
            </WrapPanel>
            <Button Grid.Column="1"
                    Content="关闭"
                    MinWidth="76"
                    IsCancel="True"
                    Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
