<Window x:Class="DesktopOrganizer.DesktopSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面快速搜索"
        Width="760"
        Height="520"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12" CornerRadius="8" Background="#FFF0F7FF"
                BorderBrush="#FF9CC8F2" BorderThickness="1">
            <TextBlock TextWrapping="Wrap"
                       Text="只搜索本程序已经加载的桌面项目，不扫描桌面之外的目录，也不读取文件正文。"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" Height="34" Padding="9,5"
                     VerticalContentAlignment="Center"
                     TextChanged="QueryBox_TextChanged"
                     PreviewKeyDown="QueryBox_PreviewKeyDown"
                     ToolTip="上下方向键选择；Enter 定位并返回桌面；Ctrl+Enter 打开；Shift+Enter 在资源管理器中显示"/>
            <ComboBox x:Name="ViewSelector" Grid.Column="1" Margin="10,0,0,0"
                      DisplayMemberPath="Name" SelectionChanged="ViewSelector_SelectionChanged"/>
        </Grid>

        <ListBox x:Name="ResultsList" Grid.Row="2"
                 MouseDoubleClick="ResultsList_MouseDoubleClick"
                 PreviewKeyDown="ResultsList_PreviewKeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Grid.Row="1" Text="{Binding Summary}" Margin="0,3,0,0"
                                   Foreground="#FF64748B" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="定位并高亮" MinWidth="96" Margin="0,0,8,0" Click="Locate_Click"
                        ToolTip="Enter（定位后返回桌面）"/>
                <Button Content="打开" MinWidth="72" Margin="0,0,8,0" Click="Open_Click"
                        ToolTip="Ctrl+Enter"/>
                <Button Content="在资源管理器中显示" MinWidth="140" Click="Reveal_Click"
                        ToolTip="Shift+Enter"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ResultCountText" Margin="0,0,14,0" VerticalAlignment="Center"
                           Foreground="#FF64748B"/>
                <Button Content="关闭" MinWidth="76" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
