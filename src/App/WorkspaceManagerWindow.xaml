<Window x:Class="DesktopOrganizer.WorkspaceManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工作区与布局快照"
        Width="710"
        Height="430"
        MinWidth="600"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="WorkspaceManagerWindow_PreviewKeyDown"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12" CornerRadius="8" Background="#FFF0F7FF" BorderBrush="#FF9CC8F2" BorderThickness="1">
            <TextBlock TextWrapping="Wrap"
                       Text="工作区只保存分组、自由图标、收起状态、面板、回收站组件和显示器拓扑。切换时只恢复视觉布局，不移动、重命名或删除真实文件。"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="WorkspaceList"
                     DisplayMemberPath="DisplayName"
                     MouseDoubleClick="WorkspaceList_MouseDoubleClick"
                     PreviewKeyDown="WorkspaceList_PreviewKeyDown"
                     ToolTip="双击或按 Enter 可确认并切换非当前工作区；F2 重命名；Ctrl+D 复制；Ctrl+S 用当前布局覆盖；Delete 删除所选快照；列表快捷键返回后可继续键盘操作"
                     SelectionChanged="WorkspaceList_SelectionChanged"/>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="14" Background="#FFF7F7F7" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="快照预览" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="PreviewText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF334155"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel>
                <Button Content="新建当前快照" MinWidth="105" Margin="0,0,8,0" Click="Create_Click"
                        ToolTip="Ctrl+N；从当前屏幕布局创建并激活新的视觉快照"/>
                <Button x:Name="DuplicateWorkspaceButton" Content="复制快照…" MinWidth="88" Margin="0,0,8,0" Click="Duplicate_Click"
                        ToolTip="Ctrl+D；从所选工作区创建独立副本，不切换当前布局"/>
                <Button x:Name="ActivateWorkspaceButton" Content="切换并恢复…" MinWidth="100" Margin="0,0,8,0" Click="Activate_Click"/>
                <Button x:Name="OverwriteWorkspaceButton" Content="用当前布局覆盖…" MinWidth="115" Margin="0,0,8,0" Click="Overwrite_Click"
                        ToolTip="Ctrl+S；确认后用当前视觉布局覆盖所选快照，不修改真实文件"/>
                <Button x:Name="RenameWorkspaceButton" Content="重命名" MinWidth="76" Margin="0,0,8,0" Click="Rename_Click"/>
                <Button x:Name="DeleteWorkspaceButton" Content="删除…" MinWidth="70" Click="Delete_Click"
                        ToolTip="Delete；确认后只删除所选视觉快照，不改变当前屏幕布局或真实文件"/>
            </WrapPanel>
            <Button Grid.Column="1" Content="关闭" MinWidth="76" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
