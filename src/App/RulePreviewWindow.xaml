<Window x:Class="DesktopOrganizer.RulePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规则逐项预览"
        Width="980"
        Height="620"
        MinWidth="820"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12"
                CornerRadius="8"
                Background="#FFF0F7FF"
                BorderBrush="#FF9CC8F2"
                BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="RuleTitleText"
                           FontSize="16"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="PurposeText"
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,5,0,0"
                           Foreground="#FF475569"
                           TextWrapping="Wrap"
                           Text="预览和执行只涉及虚拟分组、标签或待整理收件箱。手工分组冲突项不会进入执行计划；不会移动、重命名或删除真实文件。"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="2,10,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="PlanCountText"
                       Grid.Column="1"
                       Foreground="#FF475569"
                       VerticalAlignment="Center"/>
        </Grid>

        <DataGrid x:Name="PreviewGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  ClipboardCopyMode="IncludeHeader"
                  EnableRowVirtualization="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  ToolTip="选中预览行后按 Ctrl+C 复制五列详情和表头">
            <DataGrid.Columns>
                <DataGridTextColumn Header="项目" Binding="{Binding DisplayName}" Width="170"/>
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="90"/>
                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="150"/>
                <DataGridTemplateColumn Header="命中原因" Width="*"
                                        ClipboardContentBinding="{Binding Explanation}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Explanation}"
                                       Margin="4"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="冲突" Width="220"
                                        ClipboardContentBinding="{Binding ConflictText}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ConflictText}"
                                       Margin="4"
                                       Foreground="#FFB91C1C"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText"
                       Foreground="#FF64748B"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopySelectedPreviewButton"
                        Content="复制所选详情"
                        MinWidth="108"
                        Margin="12,0,8,0"
                        Command="{x:Static ApplicationCommands.Copy}"
                        CommandTarget="{Binding ElementName=PreviewGrid}"
                        ToolTip="Ctrl+C；复制所选预览行的五列详情和表头"/>
                <Button Content="取消"
                        MinWidth="76"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button x:Name="PrimaryButton"
                        MinWidth="110"
                        IsDefault="True"
                        Click="Primary_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
