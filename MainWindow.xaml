<Window x:Class="DesktopOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopOrganizer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Opacity="0"
        Topmost="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <!-- 轻量 Fluent/玻璃质感：只用渐变、描边和透明层，不使用大面积模糊。 -->
        <LinearGradientBrush x:Key="PanelSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F21C2D43" Offset="0"/>
            <GradientStop Color="#F0132134" Offset="0.62"/>
            <GradientStop Color="#F20D1828" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PanelInnerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D9253850" Offset="0"/>
            <GradientStop Color="#D917263A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ButtonSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF344861" Offset="0"/>
            <GradientStop Color="#FF26384F" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#8B7188A7"/>
        <SolidColorBrush x:Key="PanelInnerBorderBrush" Color="#28FFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF68B5F5"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF7FAFD"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFC2CFDE"/>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ButtonSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#6D6B82A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Depth"
                                    Margin="1,2,1,0"
                                    CornerRadius="7"
                                    Background="#45000000"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="Chrome"
                                    Margin="0,0,0,2"
                                    CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Border Height="1"
                                            Margin="6,0"
                                            VerticalAlignment="Top"
                                            Background="#34FFFFFF"
                                            CornerRadius="7"
                                            IsHitTestVisible="False"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF3B526F"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A58EB6DF"/>
                                <Setter TargetName="Depth" Property="Background" Value="#5A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Margin" Value="0,2,0,0"/>
                                <Setter TargetName="Depth" Property="Opacity" Value="0.25"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#FF20324A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                                <Setter TargetName="Depth" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource ButtonSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="#6D6B82A0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Depth"
                                    Margin="1,2,1,0"
                                    CornerRadius="7"
                                    Background="#45000000"
                                    IsHitTestVisible="False"/>
                            <Border x:Name="Chrome"
                                    Margin="0,0,0,2"
                                    CornerRadius="7"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Border x:Name="ActiveGlow"
                                            Opacity="0"
                                            Margin="1"
                                            CornerRadius="6"
                                            BorderBrush="#7168B5F5"
                                            BorderThickness="1"
                                            IsHitTestVisible="False"/>
                                    <Border Height="1"
                                            Margin="6,0"
                                            VerticalAlignment="Top"
                                            Background="#34FFFFFF"
                                            CornerRadius="7"
                                            IsHitTestVisible="False"/>
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"
                                                      RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF3B526F"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#A58EB6DF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF28679B"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D485CBFF"/>
                                <Setter TargetName="ActiveGlow" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Margin" Value="0,2,0,0"/>
                                <Setter TargetName="Depth" Property="Opacity" Value="0.25"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                                <Setter TargetName="Depth" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Margin" Value="2"/>
        </Style>

        <Style x:Key="GroupHeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2FFFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#78FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNWSE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path x:Name="Grip"
                                  Data="M 4,14 L 14,4 M 8,14 L 14,8 M 12,14 L 14,12"
                                  Stroke="{TemplateBinding BorderBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分类框内部使用固定的轻量滚动条，避免系统主题在透明桌面层中出现
             高饱和度横向滑块或异常强调色。水平滚动始终关闭。 -->
        <Style x:Key="GroupScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="#78D7E7F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome"
                                Margin="2,1"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#C7E7F3FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#FFEAF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="MinWidth" Value="9"/>
            <Setter Property="Background" Value="#18000000"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GroupScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Style="{StaticResource GroupScrollBarStyle}"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="RecycleWidgetActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="29"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Foreground" Value="#FFF7FAFD"/>
            <Setter Property="Background" Value="#5B22364E"/>
            <Setter Property="BorderBrush" Value="#5E91A9C3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#8B315273"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B8B8D8F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B21C3046"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9BCBFA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,2,0,3"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True"
          PreviewMouseDown="RootGrid_PreviewMouseDown"
          PreviewMouseUp="RootGrid_PreviewMouseUp"
          MouseLeave="RootGrid_MouseLeave">
        <!-- 不绘制全屏透明画刷；交互区域由 WM_NCHITTEST 的轻量矩形命中决定。 -->
        <Canvas x:Name="IconCanvas" SnapsToDevicePixels="True" />

        <!-- 回收站不再参与普通图标、分类和挤压排列，而是独立的系统小组件。 -->
        <Border x:Name="RecycleBinWidget"
                Panel.ZIndex="9000"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="252"
                Height="122"
                Margin="0"
                Visibility="Hidden"
                CornerRadius="19"
                Background="#E91B2A3B"
                BorderBrush="#8AA8C0D8"
                BorderThickness="1.2"
                PreviewMouseLeftButtonDown="RecycleBinWidget_PreviewMouseLeftButtonDown"
                ToolTip="双击打开回收站；拖动标题区域移动组件">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开回收站" Click="RecycleBinOpenButton_Click"/>
                    <MenuItem x:Name="RecycleBinContextEmptyMenuItem" Header="清空回收站…" IsEnabled="False" Click="RecycleBinEmptyButton_Click"/>
                    <Separator/>
                    <MenuItem Header="隐藏回收站组件" Click="HideRecycleBinWidgetMenuItem_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid Margin="11">
                <Border Margin="1"
                        CornerRadius="16"
                        BorderBrush="#27FFFFFF"
                        BorderThickness="1"
                        IsHitTestVisible="False"/>
                <Border Width="3"
                        Margin="0,12,0,12"
                        HorizontalAlignment="Left"
                        CornerRadius="2"
                        Background="#FF5EEAD4"
                        IsHitTestVisible="False"/>
                <Grid Margin="8,4,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="58"
                            Height="58"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="17"
                            Background="#3A80B9D8"
                            BorderBrush="#5FD4F4FF"
                            BorderThickness="1">
                        <ContentControl x:Name="RecycleBinWidgetIconHost"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsHitTestVisible="False"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="RecycleBinWidgetDragHandle"
                              Grid.Row="0"
                              Height="27"
                              Background="Transparent"
                              Cursor="SizeAll"
                              PreviewMouseLeftButtonDown="RecycleBinWidgetDragHandle_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="RecycleBinWidgetDragHandle_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="RecycleBinWidgetDragHandle_PreviewMouseMove"
                              LostMouseCapture="RecycleBinWidgetDragHandle_LostMouseCapture">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RecycleBinWidgetStatusDot"
                                    Grid.Column="0"
                                    Width="8" Height="8"
                                    Margin="0,0,7,0"
                                    CornerRadius="4"
                                    Background="#FF94A3B8"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="回收站"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="⠿"
                                       Foreground="#8FD5E5F4"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       ToolTip="拖动组件"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,1,0,5">
                            <TextBlock x:Name="RecycleBinWidgetCountText"
                                       Text="正在读取状态"
                                       Foreground="#FFF5F9FC"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="RecycleBinWidgetSizeText"
                                       Text="请稍候"
                                       Foreground="#FFAFBED0"
                                       FontSize="10.5"
                                       Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <Button Content="打开"
                                    Style="{StaticResource RecycleWidgetActionButtonStyle}"
                                    Click="RecycleBinOpenButton_Click"/>
                            <Button x:Name="RecycleBinEmptyButton"
                                    Content="清空"
                                    Style="{StaticResource RecycleWidgetActionButtonStyle}"
                                    Margin="0"
                                    IsEnabled="False"
                                    Click="RecycleBinEmptyButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ControlPanel"
                Panel.ZIndex="10000"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0"
                Visibility="Hidden"
                Padding="7"
                CornerRadius="13"
                Background="{StaticResource PanelSurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1.2"
                PreviewMouseDown="ControlPanel_PreviewMouseDown"
                MouseEnter="ControlPanel_MouseEnter"
                MouseLeave="ControlPanel_MouseLeave">
            <Grid>
                <Border Margin="1"
                        CornerRadius="11"
                        BorderBrush="{StaticResource PanelInnerBorderBrush}"
                        BorderThickness="1"
                        IsHitTestVisible="False"/>
                <Border Width="84"
                        Height="2"
                        Margin="14,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        CornerRadius="1"
                        Background="{StaticResource AccentBrush}"
                        Opacity="0.9"
                        IsHitTestVisible="False"/>

                <StackPanel Margin="3">
                    <Grid
                          MinWidth="345"
                          MinHeight="38"
                          Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 使用普通 Button，而不是会自行保持选中/捕获状态的 ToggleButton。
                             这样展开命令后，按钮的命中区域始终只等于按钮自身。 -->
                        <Button x:Name="PanelExpanderButton"
                                Grid.Column="0"
                                Content="☰  整理"
                                Style="{StaticResource ToolbarButton}"
                                MinWidth="96"
                                Click="PanelExpanderButton_Click"
                                ToolTip="展开或收起整理命令"/>

                        <!-- 只有状态胶囊是总面板拖动区，按钮和命令区域永不参与鼠标捕获。 -->
                        <Border x:Name="ControlPanelDragHandle"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Margin="10,0,8,0"
                                Padding="10,4"
                                CornerRadius="12"
                                Background="#40121E2E"
                                BorderBrush="#356E8FB3"
                                BorderThickness="1"
                                Cursor="SizeAll"
                                ToolTip="{Binding Text, ElementName=StatusText}"
                                ToolTipService.InitialShowDelay="350"
                                PreviewMouseLeftButtonDown="ControlPanelDragHandle_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ControlPanelDragHandle_PreviewMouseLeftButtonUp"
                                PreviewMouseMove="ControlPanelDragHandle_PreviewMouseMove"
                                LostMouseCapture="ControlPanelDragHandle_LostMouseCapture">
                            <TextBlock x:Name="StatusText"
                                       Text="正在加载…"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       MaxWidth="360"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False"/>
                        </Border>

                        <Button x:Name="QuickPauseButton"
                                Grid.Column="2"
                                Content="暂停"
                                Style="{StaticResource CompactButton}"
                                Focusable="False"
                                Click="PauseButton_Click"
                                ToolTip="暂停整理并临时恢复系统桌面图标"/>

                        <Button Grid.Column="3"
                                Content="×"
                                Width="32"
                                MinWidth="32"
                                Style="{StaticResource CompactButton}"
                                Focusable="False"
                                Click="HidePanelButton_Click"
                                ToolTip="隐藏控制条；可点击右上角“显示面板”、双击托盘图标或再次启动恢复"/>
                    </Grid>

                    <Border x:Name="ExpandedCommands"
                            Visibility="Collapsed"
                            Margin="0,7,0,0"
                            Padding="7"
                            CornerRadius="10"
                            Background="{StaticResource PanelInnerBrush}"
                            BorderBrush="#5C607897"
                            BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="2,0,2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2" Background="#FF68B5F5"/>
                                <TextBlock Grid.Column="1" Text="分组与布局" Style="{StaticResource SectionTitleStyle}"/>
                            </Grid>
                            <WrapPanel MaxWidth="730">
                                <ToggleButton x:Name="EditModeToggle"
                                              Content="编辑布局"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              Click="EditModeToggle_Click"
                                              ToolTip="开启后才允许移动、缩放、删除分组及拖动图标"/>
                                <Button Content="新建分组" Style="{StaticResource ToolbarButton}" Click="NewGroupButton_Click"/>
                                <Button x:Name="AutoClassifyButton"
                                        Content="识别分类"
                                        Style="{StaticResource ToolbarButton}"
                                        Click="AutoClassifyButton_Click"
                                        ToolTip="本地识别文件类型和开发项目；不会移动真实文件"/>
                                <Button Content="智能布局"
                                        Style="{StaticResource ToolbarButton}"
                                        Click="SmartArrangeGroupsButton_Click"
                                        ToolTip="按分类框真实宽高填补空隙；可优先保留主屏底部约三分之一临时区域"/>
                                <Button Content="适应全部"
                                        Style="{StaticResource ToolbarButton}"
                                        Click="AutoFitAllGroupsButton_Click"
                                        ToolTip="解除全部尺寸锁定，按内容重新计算并自动排列；可撤销"/>
                                <Button x:Name="UndoSmartLayoutButton"
                                        Content="撤销布局"
                                        Style="{StaticResource ToolbarButton}"
                                        Click="UndoSmartLayoutButton_Click"
                                        IsEnabled="False"
                                        ToolTip="恢复本次智能布局前的分组位置和尺寸"/>
                                <Button x:Name="UndoFileMoveButton"
                                        Content="撤销文件移动"
                                        Style="{StaticResource ToolbarButton}"
                                        Click="UndoFileMoveButton_Click"
                                        IsEnabled="False"
                                        ToolTip="把最近一次拖入真实文件夹的项目移回原位置"/>
                                <Button x:Name="CollapseGroupsButton"
                                        Content="全部收起"
                                        Style="{StaticResource ToolbarButton}"
                                        Click="CollapseGroupsButton_Click"
                                        ToolTip="一键收起或展开全部分组"/>
                                <Button Content="对齐图标"
                                        Style="{StaticResource ToolbarButton}"
                                        Click="AlignIconsButton_Click"
                                        ToolTip="自由图标对齐到最近的空闲网格，并避开分组"/>
                                <ToggleButton x:Name="RecycleBinWidgetToggle"
                                              Content="回收站组件"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              IsChecked="True"
                                              Click="RecycleBinWidgetToggle_Click"
                                              ToolTip="显示独立的回收站状态与快捷操作卡片"/>
                            </WrapPanel>

                            <Separator Margin="6,6" Background="#476A819E"/>
                            <Grid Margin="2,0,2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="2" Background="#FF6DD8B5"/>
                                <TextBlock Grid.Column="1" Text="自动化与行为" Style="{StaticResource SectionTitleStyle}"/>
                            </Grid>
                            <WrapPanel MaxWidth="730">
                                <ToggleButton x:Name="AutoClassifyNewItemsToggle"
                                              Content="新项目归类"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              Click="AutoClassifyNewItemsToggle_Click"
                                              ToolTip="之后出现的新桌面项目自动进入对应分类"/>
                                <Button x:Name="ClearAutoClassificationButton"
                                        Content="取消分类"
                                        Style="{StaticResource ToolbarButton}"
                                        Click="ClearAutoClassificationButton_Click"
                                        ToolTip="解散自动分类并尽量恢复原图标位置"/>
                                <ToggleButton x:Name="SnapToGridToggle"
                                              Content="网格吸附"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              IsChecked="True"
                                              Click="SnapToGridToggle_Click"/>
                                <ToggleButton x:Name="PushReflowToggle"
                                              Content="挤压排列"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              IsChecked="True"
                                              Click="PushReflowToggle_Click"/>
                                <ToggleButton x:Name="CompactGroupLayoutToggle"
                                              Content="紧凑分类框"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              Click="CompactGroupLayoutToggle_Click"
                                              ToolTip="按内容数量缩放分类框；大型分类使用四列图标"/>
                                <ToggleButton x:Name="ReserveWorkspaceToggle"
                                              Content="保留临时区"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              Click="ReserveWorkspaceToggle_Click"
                                              ToolTip="智能布局优先保留主屏底部约三分之一，方便临时放置新文件"/>
                                <ToggleButton x:Name="AutoCollapsePanelToggle"
                                              Content="面板自动收起"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              Click="AutoCollapsePanelToggle_Click"
                                              ToolTip="命令面板展开后，鼠标移开 6 秒自动收起"/>
                                <ToggleButton x:Name="AutoStartToggle"
                                              Content="开机自启"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              Click="AutoStartToggle_Click"
                                              ToolTip="Windows 登录后安静启动到通知区域"/>
                                <ToggleButton x:Name="SafeModeToggle"
                                              Content="安全模式"
                                              Style="{StaticResource ToolbarToggleButton}"
                                              Click="SafeModeToggle_Click"
                                              ToolTip="仅在本次运行中暂停实时监听、自动归类和挤压预览；不会改变原设置"/>
                            </WrapPanel>

                            <Separator Margin="6,6" Background="#476A819E"/>
                            <WrapPanel MaxWidth="730" HorizontalAlignment="Right">
                                <Button Content="刷新" Style="{StaticResource ToolbarButton}" Click="RefreshButton_Click"/>
                                <Button Content="诊断日志" Style="{StaticResource ToolbarButton}" Click="OpenDiagnosticsLogButton_Click" ToolTip="打开运行日志目录"/>
                                <Button x:Name="PauseButton"
                                        Content="暂停整理"
                                        Style="{StaticResource ToolbarButton}"
                                        Click="PauseButton_Click"
                                        ToolTip="暂停整理并临时恢复系统桌面图标"/>
                                <Button Content="隐藏面板" Style="{StaticResource ToolbarButton}" Click="HidePanelButton_Click"/>
                                <Button Content="退出" Style="{StaticResource ToolbarButton}" Click="ExitButton_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 总面板被隐藏后保留一个独立、固定的恢复入口。
             它不依赖托盘是否被 Windows 折叠，也不会参与总面板的拖动或命令布局。 -->
        <Button x:Name="ControlPanelRestoreButton"
                Panel.ZIndex="10001"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="112"
                Height="36"
                Margin="0,14,14,0"
                Padding="8,0"
                Visibility="Collapsed"
                Content="☰  显示面板"
                Style="{StaticResource ToolbarButton}"
                Click="ControlPanelRestoreButton_Click"
                ToolTip="重新显示总控制面板"/>
    </Grid>
</Window>
