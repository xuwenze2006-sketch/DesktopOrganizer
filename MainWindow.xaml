<Window x:Class="DesktopOrganizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopOrganizer"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Opacity="0"
        Topmost="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Window.Resources>
        <!-- 控制面板只保留一层实体表面和单一强调色，避免渐变、发光与多重描边叠加。 -->
        <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#F21A2430"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#52687B90"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF68B5F5"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFF4F7FA"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FFAAB6C3"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#FF7F8F9F"/>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2868B5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2468B5F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="PanelCommandButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="#09FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="7"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconSurface"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="6"
                                        Background="#1268B5F5">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#FFC4E5FF"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="13"/>
                                </Border>
                                <ContentPresenter Grid.Column="2"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2868B5F5"/>
                                <Setter TargetName="IconSurface" Property="Background" Value="#2468B5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2468B5F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelCommandToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="#09FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="7"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconSurface"
                                        Width="24"
                                        Height="24"
                                        CornerRadius="6"
                                        Background="#1268B5F5">
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#FFC4E5FF"
                                               FontFamily="Segoe UI Symbol"
                                               FontSize="13"/>
                                </Border>
                                <ContentPresenter Grid.Column="2"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                                <Border x:Name="SwitchTrack"
                                        Grid.Column="4"
                                        Width="26"
                                        Height="14"
                                        CornerRadius="7"
                                        Background="#3B718295">
                                    <Ellipse x:Name="SwitchKnob"
                                             Width="10"
                                             Height="10"
                                             Margin="2"
                                             HorizontalAlignment="Left"
                                             Fill="#FFB8C4D0"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2868B5F5"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2068B5F5"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#4268B5F5"/>
                                <Setter TargetName="IconSurface" Property="Background" Value="#2868B5F5"/>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2868B5F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Padding="3"
                                    CornerRadius="8"
                                    Background="#0CFFFFFF">
                                <UniformGrid Columns="4"
                                             IsItemsHost="True"
                                             KeyboardNavigation.TabIndex="1"
                                             Panel.ZIndex="1"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0,6,0,0"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTabItemStyle" TargetType="TabItem">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Chrome"
                                Margin="1,0"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2068B5F5"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupHeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#38FFFFFF"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2FFFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#78FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#50FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeNWSE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path x:Name="Grip"
                                  Data="M 4,14 L 14,4 M 8,14 L 14,8 M 12,14 L 14,12"
                                  Stroke="{TemplateBinding BorderBrush}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="StrokeThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分类框内部使用固定的轻量滚动条，避免系统主题在透明桌面层中出现
             高饱和度横向滑块或异常强调色。水平滚动始终关闭。 -->
        <Style x:Key="GroupScrollThumbStyle" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="#78D7E7F7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome"
                                Margin="2,1"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#C7E7F3FF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome" Property="Background" Value="#FFEAF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="9"/>
            <Setter Property="MinWidth" Value="9"/>
            <Setter Property="Background" Value="#18000000"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource GroupScrollThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Orientation="Vertical"
                                       Style="{StaticResource GroupScrollBarStyle}"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="RecycleWidgetActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="29"/>
            <Setter Property="MinWidth" Value="58"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Foreground" Value="#FFF7FAFD"/>
            <Setter Property="Background" Value="#5B22364E"/>
            <Setter Property="BorderBrush" Value="#5E91A9C3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#8B315273"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#B8B8D8F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#B21C3046"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid"
          UseLayoutRounding="True"
          SnapsToDevicePixels="True"
          PreviewMouseDown="RootGrid_PreviewMouseDown"
          PreviewMouseUp="RootGrid_PreviewMouseUp"
          MouseLeave="RootGrid_MouseLeave">
        <!-- 不绘制全屏透明画刷；交互区域由 WM_NCHITTEST 的轻量矩形命中决定。 -->
        <Canvas x:Name="IconCanvas" SnapsToDevicePixels="True" />

        <!-- 回收站不再参与普通图标、分类和挤压排列，而是独立的系统小组件。 -->
        <Border x:Name="RecycleBinWidget"
                Panel.ZIndex="9000"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="252"
                Height="122"
                Margin="0"
                Visibility="Hidden"
                CornerRadius="19"
                Background="#E91B2A3B"
                BorderBrush="#8AA8C0D8"
                BorderThickness="1.2"
                PreviewMouseLeftButtonDown="RecycleBinWidget_PreviewMouseLeftButtonDown"
                ToolTip="双击打开回收站；拖动标题区域移动组件">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开回收站" Click="RecycleBinOpenButton_Click"/>
                    <MenuItem x:Name="RecycleBinContextEmptyMenuItem" Header="清空回收站…" IsEnabled="False" Click="RecycleBinEmptyButton_Click"/>
                    <Separator/>
                    <MenuItem Header="隐藏回收站组件" Click="HideRecycleBinWidgetMenuItem_Click"/>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid Margin="11">
                <Border Margin="1"
                        CornerRadius="16"
                        BorderBrush="#27FFFFFF"
                        BorderThickness="1"
                        IsHitTestVisible="False"/>
                <Border Width="3"
                        Margin="0,12,0,12"
                        HorizontalAlignment="Left"
                        CornerRadius="2"
                        Background="#FF5EEAD4"
                        IsHitTestVisible="False"/>
                <Grid Margin="8,4,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="66"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="58"
                            Height="58"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            CornerRadius="17"
                            Background="#3A80B9D8"
                            BorderBrush="#5FD4F4FF"
                            BorderThickness="1">
                        <ContentControl x:Name="RecycleBinWidgetIconHost"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        IsHitTestVisible="False"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="RecycleBinWidgetDragHandle"
                              Grid.Row="0"
                              Height="27"
                              Background="Transparent"
                              Cursor="SizeAll"
                              PreviewMouseLeftButtonDown="RecycleBinWidgetDragHandle_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="RecycleBinWidgetDragHandle_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="RecycleBinWidgetDragHandle_PreviewMouseMove"
                              LostMouseCapture="RecycleBinWidgetDragHandle_LostMouseCapture">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="RecycleBinWidgetStatusDot"
                                    Grid.Column="0"
                                    Width="8" Height="8"
                                    Margin="0,0,7,0"
                                    CornerRadius="4"
                                    Background="#FF94A3B8"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="回收站"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="⠿"
                                       Foreground="#8FD5E5F4"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       ToolTip="拖动组件"/>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,1,0,5">
                            <TextBlock x:Name="RecycleBinWidgetCountText"
                                       Text="正在读取状态"
                                       Foreground="#FFF5F9FC"
                                       FontSize="12.5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="RecycleBinWidgetSizeText"
                                       Text="请稍候"
                                       Foreground="#FFAFBED0"
                                       FontSize="10.5"
                                       Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <Button Content="打开"
                                    Style="{StaticResource RecycleWidgetActionButtonStyle}"
                                    Click="RecycleBinOpenButton_Click"/>
                            <Button x:Name="RecycleBinEmptyButton"
                                    Content="清空"
                                    Style="{StaticResource RecycleWidgetActionButtonStyle}"
                                    Margin="0"
                                    IsEnabled="False"
                                    Click="RecycleBinEmptyButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="ControlPanel"
                Panel.ZIndex="10000"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0"
                Visibility="Hidden"
                Padding="8"
                CornerRadius="12"
                Background="{StaticResource PanelSurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                PreviewMouseDown="ControlPanel_PreviewMouseDown"
                MouseEnter="ControlPanel_MouseEnter"
                MouseLeave="ControlPanel_MouseLeave">
            <StackPanel>
                <Grid MinWidth="306"
                          Height="34"
                          Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 使用普通 Button，而不是会自行保持选中/捕获状态的 ToggleButton。
                             这样展开命令后，按钮的命中区域始终只等于按钮自身。 -->
                        <Button x:Name="PanelExpanderButton"
                                Grid.Column="0"
                                Content="整理  ▾"
                                Style="{StaticResource ToolbarButton}"
                                MinWidth="78"
                                Background="#1468B5F5"
                                BorderBrush="#2868B5F5"
                                Click="PanelExpanderButton_Click"
                                ToolTip="展开或收起整理命令"/>

                        <!-- 状态文字兼作拖动区；命令、页签和按钮永不参与鼠标捕获。 -->
                        <Border x:Name="ControlPanelDragHandle"
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Margin="8,0"
                                Padding="2,0"
                                Background="Transparent"
                                Cursor="SizeAll"
                                ToolTip="{Binding Text, ElementName=StatusText}"
                                ToolTipService.InitialShowDelay="350"
                                PreviewMouseLeftButtonDown="ControlPanelDragHandle_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="ControlPanelDragHandle_PreviewMouseLeftButtonUp"
                                PreviewMouseMove="ControlPanelDragHandle_PreviewMouseMove"
                                LostMouseCapture="ControlPanelDragHandle_LostMouseCapture">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⠿"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontFamily="Segoe UI Symbol"
                                           FontSize="11"
                                           IsHitTestVisible="False"/>
                                <TextBlock x:Name="StatusText"
                                           Grid.Column="1"
                                           Text="正在加载…"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="11.5"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <Button x:Name="QuickPauseButton"
                                Grid.Column="2"
                                Content="暂停"
                                Style="{StaticResource CompactButton}"
                                Focusable="False"
                                Click="PauseButton_Click"
                                ToolTip="暂停整理并临时恢复系统桌面图标"/>

                        <Button Grid.Column="3"
                                Content="×"
                                Width="28"
                                MinWidth="28"
                                Style="{StaticResource CompactButton}"
                                Focusable="False"
                                Click="HidePanelButton_Click"
                                ToolTip="隐藏控制条；可点击右上角“显示面板”、双击托盘图标或再次启动恢复"/>
                </Grid>

                    <!-- 四个单页按需呈现 30 个命令；同一时刻最多显示八项。 -->
                    <Border x:Name="ExpandedCommands"
                            Visibility="Collapsed"
                            Margin="0,8,0,0"
                            Width="420"
                            Background="Transparent">
                        <TabControl x:Name="ControlPanelTabs"
                                    SelectedIndex="0"
                                    PreviewMouseLeftButtonDown="ControlPanelTabs_PreviewMouseLeftButtonDown"
                                    Style="{StaticResource PanelTabControlStyle}">
                            <TabItem x:Name="CommonCommandTab"
                                     Header="常用"
                                     IsSelected="True"
                                     Style="{StaticResource PanelTabItemStyle}">
                                <StackPanel>
                                    <TextBlock Margin="4,0,4,3"
                                               Text="高频入口 · 整理只改变本地桌面状态"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontFamily="Microsoft YaHei UI"
                                               FontSize="11.5"/>
                                    <UniformGrid Height="152" Columns="2" VerticalAlignment="Top">
                                        <Button Content="搜索桌面"
                                                Tag="⌕"
                                                AutomationProperties.AutomationId="desktop-search"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="DesktopSearchButton_Click"
                                                ToolTip="仅搜索已加载的桌面项目，不扫描其他目录或文件正文"/>
                                        <Button x:Name="InboxButton"
                                                Content="待整理"
                                                Tag="◎"
                                                AutomationProperties.AutomationId="inbox"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="InboxButton_Click"
                                                ToolTip="新出现的桌面项目会先进入本地待整理收件箱"/>
                                        <Button Content="新建分组"
                                                Tag="＋"
                                                AutomationProperties.AutomationId="new-group"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="NewGroupButton_Click"
                                                ToolTip="创建不会移动真实文件的手工分组"/>
                                        <Button x:Name="AutoClassifyButton"
                                                Content="识别分类"
                                                Tag="◈"
                                                AutomationProperties.AutomationId="auto-classify"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="AutoClassifyButton_Click"
                                                ToolTip="本地识别文件类型和开发项目；不会移动真实文件"/>
                                        <Button Content="智能布局"
                                                Tag="▦"
                                                AutomationProperties.AutomationId="smart-layout"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="SmartArrangeGroupsButton_Click"
                                                ToolTip="按分类框真实宽高填补空隙；可优先保留主屏底部约三分之一临时区域"/>
                                        <Button Content="工作区"
                                                Tag="▤"
                                                AutomationProperties.AutomationId="workspaces"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="WorkspaceManagerButton_Click"
                                                ToolTip="创建、预览和切换只改变视觉布局的命名工作区"/>
                                        <Button Content="文件夹入口"
                                                Tag="▣"
                                                AutomationProperties.AutomationId="folder-portals"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="FolderPortalButton_Click"
                                                ToolTip="把指定真实文件夹以只读入口显示在桌面；不开放拖入、删除或重命名"/>
                                        <Button x:Name="PauseButton"
                                                Content="暂停整理"
                                                Tag="Ⅱ"
                                                AutomationProperties.AutomationId="pause"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="PauseButton_Click"
                                                ToolTip="暂停整理并临时恢复系统桌面图标"/>
                                    </UniformGrid>
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="LayoutCommandTab"
                                     Header="布局"
                                     Style="{StaticResource PanelTabItemStyle}">
                                <StackPanel>
                                    <TextBlock Margin="4,0,4,3"
                                               Text="调整分组与图标，不移动真实文件"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontFamily="Microsoft YaHei UI"
                                               FontSize="11.5"/>
                                    <UniformGrid Height="152" Columns="2" VerticalAlignment="Top">
                                        <ToggleButton x:Name="EditModeToggle"
                                                      Content="编辑布局"
                                                      Tag="✎"
                                                      AutomationProperties.AutomationId="edit-layout"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      Click="EditModeToggle_Click"
                                                      ToolTip="开启后才允许移动、缩放、删除分组及拖动图标"/>
                                        <Button Content="适应全部"
                                                Tag="↔"
                                                AutomationProperties.AutomationId="fit-all"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="AutoFitAllGroupsButton_Click"
                                                ToolTip="解除全部尺寸锁定，按内容重新计算并自动排列；可撤销"/>
                                        <Button x:Name="UndoSmartLayoutButton"
                                                Content="撤销布局"
                                                Tag="↶"
                                                AutomationProperties.AutomationId="undo-layout"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="UndoSmartLayoutButton_Click"
                                                IsEnabled="False"
                                                ToolTip="恢复本次智能布局前的分组位置和尺寸"/>
                                        <Button x:Name="UndoFileMoveButton"
                                                Content="撤销移动"
                                                Tag="↩"
                                                AutomationProperties.AutomationId="undo-file-move"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="UndoFileMoveButton_Click"
                                                IsEnabled="False"
                                                ToolTip="把最近一次拖入真实文件夹的项目移回原位置"/>
                                        <Button x:Name="CollapseGroupsButton"
                                                Content="全部收起"
                                                Tag="⌃"
                                                AutomationProperties.AutomationId="collapse-groups"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="CollapseGroupsButton_Click"
                                                ToolTip="一键收起或展开全部分组"/>
                                        <Button Content="对齐图标"
                                                Tag="⊞"
                                                AutomationProperties.AutomationId="align-icons"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="AlignIconsButton_Click"
                                                ToolTip="自由图标对齐到最近的空闲网格，并避开分组"/>
                                        <ToggleButton x:Name="CompactGroupLayoutToggle"
                                                      Content="紧凑分组"
                                                      Tag="≋"
                                                      AutomationProperties.AutomationId="compact-groups"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      Click="CompactGroupLayoutToggle_Click"
                                                      ToolTip="按内容数量缩放分类框；大型分类使用四列图标"/>
                                        <ToggleButton x:Name="RecycleBinWidgetToggle"
                                                      Content="回收站"
                                                      Tag="♻"
                                                      AutomationProperties.AutomationId="recycle-bin-widget"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      IsChecked="True"
                                                      Click="RecycleBinWidgetToggle_Click"
                                                      ToolTip="显示独立的回收站状态与快捷操作卡片"/>
                                    </UniformGrid>
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="AutomationCommandTab"
                                     Header="自动化"
                                     Style="{StaticResource PanelTabItemStyle}">
                                <StackPanel>
                                    <TextBlock Margin="4,0,4,3"
                                               Text="规则默认禁用，自动结果保持可解释"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontFamily="Microsoft YaHei UI"
                                               FontSize="11.5"/>
                                    <UniformGrid Height="152" Columns="2" VerticalAlignment="Top">
                                        <Button Content="自定义规则"
                                                Tag="⌘"
                                                AutomationProperties.AutomationId="rules"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="RuleManagerButton_Click"
                                                ToolTip="规则保存后默认禁用，必须预览、执行一次后才能启用自动应用"/>
                                        <ToggleButton x:Name="AutoClassifyNewItemsToggle"
                                                      Content="新项目归类"
                                                      Tag="◇"
                                                      AutomationProperties.AutomationId="auto-classify-new"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      Click="AutoClassifyNewItemsToggle_Click"
                                                      ToolTip="之后出现的新桌面项目自动进入对应分类"/>
                                        <Button x:Name="ClearAutoClassificationButton"
                                                Content="取消自动分类"
                                                Tag="⊘"
                                                AutomationProperties.AutomationId="clear-auto-classification"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="ClearAutoClassificationButton_Click"
                                                ToolTip="解散自动分类并尽量恢复原图标位置"/>
                                        <ToggleButton x:Name="SnapToGridToggle"
                                                      Content="网格吸附"
                                                      Tag="#"
                                                      AutomationProperties.AutomationId="snap-to-grid"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      IsChecked="True"
                                                      Click="SnapToGridToggle_Click"
                                                      ToolTip="拖动图标时对齐到桌面网格"/>
                                        <ToggleButton x:Name="PushReflowToggle"
                                                      Content="挤压排列"
                                                      Tag="⇥"
                                                      AutomationProperties.AutomationId="push-reflow"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      IsChecked="True"
                                                      Click="PushReflowToggle_Click"
                                                      ToolTip="拖动图标时预览并提交同组项目挤压排列"/>
                                        <ToggleButton x:Name="ReserveWorkspaceToggle"
                                                      Content="保留临时区"
                                                      Tag="▱"
                                                      AutomationProperties.AutomationId="reserve-workspace"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      Click="ReserveWorkspaceToggle_Click"
                                                      ToolTip="智能布局优先保留主屏底部约三分之一，方便临时放置新文件"/>
                                        <ToggleButton x:Name="AutoCollapsePanelToggle"
                                                      Content="自动收起"
                                                      Tag="⌄"
                                                      AutomationProperties.AutomationId="auto-collapse-panel"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      Click="AutoCollapsePanelToggle_Click"
                                                      ToolTip="命令面板展开后，鼠标移开 6 秒自动收起"/>
                                    </UniformGrid>
                                </StackPanel>
                            </TabItem>

                            <TabItem x:Name="SystemCommandTab"
                                     Header="系统"
                                     Style="{StaticResource PanelTabItemStyle}">
                                <StackPanel>
                                    <TextBlock Margin="4,0,4,3"
                                               Text="运行状态、日志与安全退出"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontFamily="Microsoft YaHei UI"
                                               FontSize="11.5"/>
                                    <UniformGrid Height="152" Columns="2" VerticalAlignment="Top">
                                        <ToggleButton x:Name="AutoStartToggle"
                                                      Content="开机自启"
                                                      Tag="↗"
                                                      AutomationProperties.AutomationId="auto-start"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      Click="AutoStartToggle_Click"
                                                      ToolTip="Windows 登录后安静启动到通知区域"/>
                                        <ToggleButton x:Name="SafeModeToggle"
                                                      Content="安全模式"
                                                      Tag="◆"
                                                      AutomationProperties.AutomationId="safe-mode"
                                                      Style="{StaticResource PanelCommandToggleStyle}"
                                                      Click="SafeModeToggle_Click"
                                                      ToolTip="仅在本次运行中暂停实时监听、自动归类和挤压预览；不会改变原设置"/>
                                        <Button Content="刷新"
                                                Tag="↻"
                                                AutomationProperties.AutomationId="refresh"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="RefreshButton_Click"
                                                ToolTip="重新扫描桌面并刷新分类与布局状态"/>
                                        <Button Content="诊断日志"
                                                Tag="≡"
                                                AutomationProperties.AutomationId="diagnostics"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="OpenDiagnosticsLogButton_Click"
                                                ToolTip="打开运行日志目录"/>
                                        <Button Content="操作中心"
                                                Tag="☷"
                                                AutomationProperties.AutomationId="operation-center"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="OperationCenterButton_Click"
                                                ToolTip="查看逐项真实文件操作、恢复核验结果和撤销能力；不会自动重试"/>
                                        <Button x:Name="HidePanelCommandButton"
                                                Content="隐藏面板"
                                                Tag="—"
                                                AutomationProperties.AutomationId="hide-panel"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="HidePanelButton_Click"
                                                ToolTip="隐藏控制条；可点击右上角“显示面板”、双击托盘图标或再次启动恢复"/>
                                        <Button Content="退出"
                                                Tag="×"
                                                AutomationProperties.AutomationId="exit"
                                                Style="{StaticResource PanelCommandButtonStyle}"
                                                Click="ExitButton_Click"
                                                ToolTip="退出桌面整理；不会删除或移动桌面文件"/>
                                    </UniformGrid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </StackPanel>
        </Border>

        <!-- 总面板被隐藏后保留一个独立、固定的恢复入口。
             它不依赖托盘是否被 Windows 折叠，也不会参与总面板的拖动或命令布局。 -->
        <Button x:Name="ControlPanelRestoreButton"
                Panel.ZIndex="10001"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="104"
                Height="34"
                Margin="0,14,14,0"
                Padding="8,0"
                Visibility="Collapsed"
                Content="显示面板"
                Background="{StaticResource PanelSurfaceBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                Style="{StaticResource ToolbarButton}"
                Click="ControlPanelRestoreButton_Click"
                ToolTip="重新显示总控制面板"/>
    </Grid>
</Window>
