<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DesktopOrganizer.ico</ApplicationIcon>
    <AssemblyName>DesktopOrganizer</AssemblyName>
    <RootNamespace>DesktopOrganizer</RootNamespace>
    <Version>1.12.15</Version>
    <FileVersion>1.12.15.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Pets\PixelPawsCat.png" />
    <Resource Include="Assets\Pets\VPet\*.png" />
    <Resource Include="Assets\Pets\VPet\manifest.json" />
    <Resource Include="Assets\Scenes\TreeGrass\background.png" />
    <Resource Include="Assets\Scenes\TreeGrass\foreground.png" />
    <Resource Include="ThirdParty\VPet-ANIMATION-LICENSE.txt" />
    <Content Include="ThirdParty\VPet-ANIMATION-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ThirdParty\PixelPaws-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
