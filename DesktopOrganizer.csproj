<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DesktopOrganizer.ico</ApplicationIcon>
    <AssemblyName>DesktopOrganizer</AssemblyName>
    <RootNamespace>DesktopOrganizer</RootNamespace>
    <Version>1.12.15</Version>
    <FileVersion>1.12.15.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
