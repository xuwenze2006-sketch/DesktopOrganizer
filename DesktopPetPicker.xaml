<UserControl x:Class="DesktopOrganizer.DesktopPetPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAF8F3" Foreground="#302F2B"
             UseLayoutRounding="True" MinWidth="360">
    <UserControl.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DEDCD5"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#91AC92"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#EAF1E7"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="#587F5F"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#34593B"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="CharacterCard">
            <StackPanel>
                <Image Source="{Binding Preview}" Height="128" Stretch="Uniform" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#625F57"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="5,0,5,10">
            <TextBlock Text="选择你的桌面伙伴" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="已导入的角色与组合 · 选择后可预览动作" Foreground="#625F57" Margin="0,5,0,0"/>
        </StackPanel>
        <ListBox x:Name="Characters" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 SelectionMode="Single" ItemTemplate="{StaticResource CharacterCard}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="Characters_SelectionChanged" AutomationProperties.Name="已导入的桌宠">
            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="5,12,5,0">
            <WrapPanel>
                <CheckBox x:Name="ShowPet" Content="显示在桌面" Margin="0,0,22,8"/>
                <CheckBox x:Name="ShowScene" Content="搭配树与草地" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock x:Name="SelectedDescription" TextWrapping="Wrap" Foreground="#4B6750" Margin="0,0,0,12"/>
            <DockPanel LastChildFill="False">
                <Button x:Name="PreviewButton" DockPanel.Dock="Left" Content="预览动作" Padding="12,7" Click="Preview_Click"/>
                <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="应用选择" Padding="20,7"
                        Background="#E0EBDE" IsDefault="True" Click="Apply_Click"/>
                <Button DockPanel.Dock="Right" Content="取消" Padding="12,7" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
